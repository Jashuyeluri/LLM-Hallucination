# Copy this file to .env and add your own Groq key.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional local NLI verifier (requires requirements-nli.txt)
ENABLE_NLI=true
VERIFIER_MODE=llm
ENABLE_GUARD=true
ENABLE_CONSISTENCY=true
RAG_ENABLE_SEMANTIC=false
MAX_ITERATIONS=3
